{
	"name": "ROS 2 Workspace",
	//"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		// For CUDA support uncomment the following line.
		"ghcr.io/devcontainers/features/nvidia-cuda:3": {
			"installToolkit": true
		},
		// For GUI applications on native Linux using X11, uncomment this feature.
		// "ghcr.io/althack/devcontainers/linux-x11-forwarding:0": {},
		"ghcr.io/althack/devcontainers/ros2:0": {
			"distro": "lyrical",
			"package": "desktop"
		}
	},
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}"
	},	
	"runArgs": [
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		// For GUI applications on Linux, the IPC namespace may need to be shared with the host.
		"--ipc=host",
		// For CUDA support, uncomment the following line. This allows the container to access the GPU on the host machine.
		"--gpus",
		"all",
		"-v", "/tmp/.X11-unix:/tmp/.X11-unix:ro"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"althack.ament-task-provider",
				"ms-python.autopep8",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-vscode.cpptools",
				"Ranch-Hand-Robotics.rde-pack",
				"redhat.vscode-yaml",
				"zachflower.uncrustify"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash" 
			}
		}
	},
	//"remoteUser": "vscode",
	// Bind mount the host's home directory into the container
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/home,target=/home/vscode,type=bind"
	],
	"postCreateCommand": {
		//"npm-init": "npm init -y",
		//"install-deps": "npm install --save-dev @devcontainers/cli",
	}	
}
